{
  "name": "vehicle-screening",
  "productName": "车辆进出筛选工具",
  "version": "1.0.0",
  "description": "本地车辆通行记录筛查桌面工具（卡口配对 / 绝对时间 / 频繁出现 / 重点人 / 夜间停留）",
  "author": "Vehicle Screening",
  "license": "MIT",
  "private": true,
  "main": "main/main.js",
  "scripts": {
    "build:icon": "node scripts/make-icon.js",
    "prestart": "npm run build:icon",
    "start": "electron .",
    "server": "node server/index.js",
    "test:api": "node ../tests/workflow_driver.cjs api",
    "predist": "npm run build:icon",
    "dist": "electron-builder --win --x64 --ia32",
    "predist:x64": "npm run build:icon",
    "dist:x64": "electron-builder --win --x64",
    "predist:ia32": "npm run build:icon",
    "dist:ia32": "electron-builder --win --ia32",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "multer": "^1.4.5-lts.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": "22.3.27",
    "electron-builder": "^24.13.3"
  }
}
